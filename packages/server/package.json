{
  "name": "@hakeee/vault-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/server": "^14.0.0",
    "drizzle-orm": "^0.45.0",
    "openid-client": "^6.8.1",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@fastify/secure-session": "^8.1.1",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@fastify/secure-session": "^8.1.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.11",
    "fastify": "^5.5.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4"
  },
  "files": [
    "dist",
    "src",
    "migrations",
    "!src/**/*.test.ts"
  ]
